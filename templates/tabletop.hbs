<div class="fvtt-card-table-container">
  <!-- BARRA DE MODO DE JOGO (EXCLUSIVA DO GM) E CONTROLES DA PARTIDA -->
  <header class="fvtt-ct-toolbar">
    <div class="fvtt-ct-modes">
      {{#if isGM}}
        <span class="fvtt-ct-gm-label"><i class="fa-solid fa-crown"></i> GM:</span>
        <button type="button" class="fvtt-ct-btn {{#if isPoker}}active{{/if}}" data-action="setGameMode" data-mode="poker">
          <i class="fa-solid fa-coins"></i> Poker
        </button>
        <button type="button" class="fvtt-ct-btn {{#if isBuraco}}active{{/if}}" data-action="setGameMode" data-mode="buraco">
          <i class="fa-solid fa-layer-group"></i> Buraco
        </button>
        <button type="button" class="fvtt-ct-btn {{#if isMtg}}active{{/if}}" data-action="setGameMode" data-mode="mtg">
          <i class="fa-solid fa-wand-magic-sparkles"></i> MTG
        </button>
        <button type="button" class="fvtt-ct-btn primary" data-action="bootstrapZones" title="Cria Baralho, Mãos Privadas de cada jogador, Mesa e Descarte automaticamente">
          <i class="fa-solid fa-magic"></i> Preparar Mesa
        </button>
      {{else}}
        <span class="fvtt-ct-badge-gold"><i class="fa-solid fa-diamond"></i> {{gameModeLabel}}</span>
      {{/if}}
    </div>

    <!-- AÇÕES ESPECÍFICAS DO MODO ATIVO (CONTROLES DO CRUPIÊ / GM) -->
    <div class="fvtt-ct-mode-actions">
      {{#if isPoker}}
        {{#if isGM}}
          <button type="button" class="fvtt-ct-btn primary" data-action="pokerStartRound" title="Crupiê: Recolhe tudo, embaralha e dá 2 cartas privadas para cada jogador">
            <i class="fa-solid fa-hat-wizard"></i> Nova Mão (2 Cartas)
          </button>
          <button type="button" class="fvtt-ct-btn primary" data-action="pokerStage" data-stage="auto" title="Crupiê queima 1 carta e abre a próxima etapa (Flop -> Turn -> River)">
            <i class="fa-solid fa-forward-step"></i> Crupiê: Próxima Etapa
          </button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerStage" data-stage="flop">Flop</button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerStage" data-stage="turn">Turn</button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerStage" data-stage="river">River</button>
          <button type="button" class="fvtt-ct-btn danger" data-action="pokerResetPot" title="Zera o Pote e as apostas da rodada">
            <i class="fa-solid fa-broom"></i> Zerar Pote
          </button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerBuyInAll" data-amount="1000" title="Define 1.000 fichas para todos os jogadores">
            <i class="fa-solid fa-coins"></i> Buy-in (1.000)
          </button>
        {{/if}}
      {{/if}}

      {{#if isMtg}}
        <button type="button" class="fvtt-ct-btn" data-action="untapAll" title="Ctrl+U: Desvirar todas as permanentes">
          <i class="fa-solid fa-rotate-left"></i> Untap All
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="scryDeck" data-count="2">
          <i class="fa-solid fa-eye"></i> Scry 2
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="mulliganHand">
          <i class="fa-solid fa-shuffle"></i> Mulligan
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="createToken">
          <i class="fa-solid fa-plus-circle"></i> Criar Token
        </button>
      {{/if}}

      {{#if isBuraco}}
        {{#if isGM}}
          <button type="button" class="fvtt-ct-btn primary" data-action="buracoSetup">
            <i class="fa-solid fa-play"></i> Distribuir Mesa (11 + Mortos)
          </button>
        {{/if}}
        <button type="button" class="fvtt-ct-btn" data-action="buracoBuyTrash">
          <i class="fa-solid fa-hand-holding"></i> Comprar Lixo
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="buracoPlayMeld">
          <i class="fa-solid fa-check-double"></i> Baixar Jogo Selecionado
        </button>
      {{/if}}
    </div>
  </header>

  <!-- ÁREA CENTRAL: ZONAS LATERAIS COMPACTAS (DECK + DESCARTE) E CAMPO DE BATALHA / MESA -->
  <div class="fvtt-ct-main-grid">
    <!-- COLUNA ESQUERDA COMPACTA: BARALHO E LIXO/CEMITÉRIO/QUEIMA -->
    <aside class="fvtt-ct-sidebar-zones">
      <div class="fvtt-ct-zone-box">
        <h4><i class="fa-solid fa-layer-group"></i> {{#if deck}}{{deck.name}}{{else}}Sem Baralho{{/if}}</h4>
        {{#if deck}}
          <div class="fvtt-ct-deck-counter">{{deck.availableCount}} / {{deck.totalCount}} cartas</div>
          <div class="fvtt-ct-zone-buttons">
            <button type="button" class="fvtt-ct-btn" data-action="drawCard" data-count="1">Comprar 1</button>
            <button type="button" class="fvtt-ct-btn" data-action="shuffleDeck">Embaralhar</button>
            {{#if isGM}}
              <button type="button" class="fvtt-ct-btn" data-action="recallDeck">Resetar</button>
            {{/if}}
          </div>
        {{else}}
          <p class="fvtt-ct-empty">Peça ao GM para clicar em <strong>"Preparar Mesa"</strong>.</p>
        {{/if}}
      </div>

      <div class="fvtt-ct-zone-box fvtt-ct-discard-box">
        <h4>
          <i class="fa-solid fa-fire"></i>
          {{#if isBuraco}}Lixo ({{discard.count}}){{else if isPoker}}Queima / Muck ({{discard.count}}){{else}}Cemitério ({{discard.count}}){{/if}}
        </h4>
        {{#if discard.topCard}}
          <div class="fvtt-ct-card-mini">
            <img src="{{discard.topCard.img}}" alt="{{discard.topCard.name}}" />
            <span class="fvtt-ct-card-mini-label">
              {{#if discard.topCard.isFaceDown}}Carta Oculta / Queimada{{else}}{{discard.topCard.name}}{{/if}}
            </span>
          </div>
        {{else}}
          <p class="fvtt-ct-empty">Vazio</p>
        {{/if}}
      </div>

      {{#if isPoker}}
        <!-- PLACAR DE FICHAS DOS JOGADORES E ENTREGA DO POTE -->
        <div class="fvtt-ct-zone-box fvtt-ct-players-bank">
          <h4><i class="fa-solid fa-users"></i> Banca dos Jogadores</h4>
          <div class="fvtt-ct-player-list">
            {{#each playerChipStacks as |p|}}
              <div class="fvtt-ct-player-row {{#if p.folded}}is-folded{{/if}}">
                <div class="fvtt-ct-player-info">
                  <strong>{{p.name}}</strong>
                  <span class="fvtt-ct-player-chips">🪙 {{p.chips}}</span>
                  {{#if p.roundBet}}
                    <span class="fvtt-ct-player-bet">(Na mesa: {{p.roundBet}})</span>
                  {{/if}}
                  {{#if p.folded}}
                    <span class="fvtt-ct-folded-tag">FOLD</span>
                  {{/if}}
                </div>
                {{#if ../isGM}}
                  <button
                    type="button"
                    class="fvtt-ct-btn award-btn"
                    data-action="pokerAwardPot"
                    data-hand-id="{{p.handId}}"
                    title="Entregar todo o Pote da mesa para {{p.name}}"
                  >
                    🏆 Dar Pote
                  </button>
                {{/if}}
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </aside>

    <!-- ÁREA CENTRAL: TABLEZONE / CRUPIÊ TEXAS HOLD'EM / BATTLEFIELD -->
    <main class="fvtt-ct-battlefield">
      <div class="fvtt-ct-zone-header">
        <h3>
          {{#if isPoker}}
            🎩 Mesa Texas Hold'em — Pote Total: <span class="fvtt-ct-badge-gold">💰 {{battlefield.pot}} fichas</span>
            {{#if battlefield.currentBet}}
              <span class="fvtt-ct-current-bet-badge">Aposta Atual: {{battlefield.currentBet}} fichas</span>
            {{/if}}
          {{else if isBuraco}}
            Jogos Baixados / Canastras — Pontos: <span class="fvtt-ct-badge-gold">{{battlefield.buracoScore.total}} pts</span>
          {{else}}
            Campo de Batalha (TableZone)
          {{/if}}
        </h3>
      </div>

      {{#if isPoker}}
        <!-- 5 SLOTS OFICIAIS DO CRUPIÊ (FLOP 1, FLOP 2, FLOP 3, TURN, RIVER) -->
        <div class="fvtt-ct-dealer-board">
          {{#each dealerSlots as |slot|}}
            <div class="fvtt-ct-dealer-slot {{#if slot.card}}filled{{/if}}">
              <div class="fvtt-ct-slot-label">{{slot.label}}</div>
              {{#if slot.card}}
                <div class="fvtt-ct-card" data-card-id="{{slot.card.id}}" data-zone="battlefield">
                  <div class="fvtt-ct-card-image-wrap">
                    <img src="{{slot.card.img}}" alt="{{slot.card.name}}" />
                  </div>
                  <div class="fvtt-ct-card-title">{{slot.card.name}}</div>
                </div>
              {{else}}
                <div class="fvtt-ct-slot-placeholder">
                  <span>Aguardando Crupiê</span>
                </div>
              {{/if}}
            </div>
          {{/each}}
        </div>

        <!-- ÁREA DE SHOWDOWN (CARTAS BAIXADAS DA MÃO PELOS JOGADORES) -->
        <div class="fvtt-ct-showdown-section">
          <h4><i class="fa-solid fa-eye"></i> Showdown — Cartas Reveladas pelos Jogadores</h4>
          <div class="fvtt-ct-card-grid">
            {{#each showdownCards as |card|}}
              <div class="fvtt-ct-card" data-card-id="{{card.id}}" data-zone="battlefield">
                <div class="fvtt-ct-card-image-wrap">
                  <img src="{{card.img}}" alt="{{card.name}}" />
                  {{#if card.playedBy}}
                    <span class="fvtt-ct-meld-tag">{{card.playedBy}}</span>
                  {{/if}}
                </div>
                <div class="fvtt-ct-card-title">{{#if card.isFaceDown}}Carta Oculta{{else}}{{card.name}}{{/if}}</div>
                <div class="fvtt-ct-card-actions">
                  <button type="button" data-action="flipCard" title="Virar Face/Verso">
                    <i class="fa-solid fa-repeat"></i>
                  </button>
                  <button type="button" data-action="discardCard" title="Enviar para Muck / Descarte">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              </div>
            {{else}}
              <p class="fvtt-ct-empty">Nenhuma carta de jogador revelada ainda (clique em "Jogar" na sua mão na hora do Showdown).</p>
            {{/each}}
          </div>
        </div>
      {{else}}
        <!-- MODO MTG / BURACO -->
        <div class="fvtt-ct-card-grid">
          {{#each battlefield.cards as |card|}}
            <div
              class="fvtt-ct-card {{#if card.tapped}}is-tapped{{/if}} {{#if card.selected}}is-selected{{/if}}"
              data-card-id="{{card.id}}"
              data-zone="battlefield"
            >
              <div class="fvtt-ct-card-image-wrap" data-action="toggleTapCard" title="Clique para Virar 90° (Tap/Untap)">
                <img src="{{card.img}}" alt="{{card.name}}" />
                {{#if card.meldGroupId}}
                  <span class="fvtt-ct-meld-tag">Jogo #{{card.meldGroupId}}</span>
                {{/if}}
                {{#if card.counters.plusOne}}
                  <span class="fvtt-ct-counter-badge plus-one">+{{card.counters.plusOne}}/+{{card.counters.plusOne}}</span>
                {{/if}}
              </div>
              <div class="fvtt-ct-card-title">{{card.name}}</div>
              <div class="fvtt-ct-card-actions">
                <button type="button" data-action="toggleTapCard" title="Tap / Untap (90°)">
                  <i class="fa-solid fa-rotate-right"></i>
                </button>
                <button type="button" data-action="flipCard" title="Virar Face/Verso">
                  <i class="fa-solid fa-repeat"></i>
                </button>
                {{#if ../isMtg}}
                  <button type="button" data-action="modifyCounter" data-counter="plusOne" data-delta="1" title="+1/+1">
                    +1
                  </button>
                  <button type="button" data-action="modifyCounter" data-counter="plusOne" data-delta="-1" title="-1/-1">
                    -1
                  </button>
                {{/if}}
                <button type="button" data-action="discardCard" title="Enviar para Cemitério / Lixo">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          {{else}}
            <p class="fvtt-ct-empty">Nenhuma carta na mesa no momento.</p>
          {{/each}}
        </div>
      {{/if}}
    </main>
  </div>

  <!-- DOCK INFERIOR: MÃO PRIVADA DO JOGADOR LOGADO + CONTROLES DE APOSTA DE FICHAS -->
  <footer class="fvtt-ct-hand-dock">
    <div class="fvtt-ct-hand-header">
      <div class="fvtt-ct-hand-title-group">
        <h4>
          <i class="fa-solid fa-lock"></i>
          {{#if hand}}
            {{hand.name}} ({{hand.cards.length}} cartas)
          {{else}}
            Sem Mão Privada
            <button type="button" class="fvtt-ct-btn primary" data-action="ensureMyHand">Criar Minha Mão Privada</button>
          {{/if}}
        </h4>

        {{#if isPoker}}
          {{#if hand}}
            <div class="fvtt-ct-chip-wallet">
              <span class="fvtt-ct-wallet-balance">🪙 Minhas Fichas: <strong>{{hand.chips}}</strong></span>
              <span class="fvtt-ct-wallet-round">Na rodada: <strong>{{hand.roundBet}}</strong></span>
            </div>
          {{/if}}
        {{/if}}
      </div>

      <div class="fvtt-ct-hand-controls">
        {{#if isPoker}}
          {{#if hand}}
            <!-- BARRA DE APOSTAS DO JOGADOR (CHECK/CALL, FICHAS, CUSTOM, ALL-IN, FOLD) -->
            <button type="button" class="fvtt-ct-btn primary" data-action="pokerCheckOrCall">
              {{#if hand.canCheck}}
                ✊ Check (Mesa)
              {{else}}
                📞 Call (Pagar {{hand.toCall}})
              {{/if}}
            </button>
            <button type="button" class="fvtt-ct-chip-btn chip-10" data-action="pokerBet" data-amount="10">+10</button>
            <button type="button" class="fvtt-ct-chip-btn chip-25" data-action="pokerBet" data-amount="25">+25</button>
            <button type="button" class="fvtt-ct-chip-btn chip-50" data-action="pokerBet" data-amount="50">+50</button>
            <button type="button" class="fvtt-ct-chip-btn chip-100" data-action="pokerBet" data-amount="100">+100</button>
            <div class="fvtt-ct-custom-bet-wrap">
              <input type="number" class="fvtt-ct-custom-bet-input" placeholder="Valor" min="1" step="5" value="20" />
              <button type="button" class="fvtt-ct-btn" data-action="pokerCustomBet">Apostar</button>
            </div>
            <button type="button" class="fvtt-ct-btn allin-btn" data-action="pokerAllIn">
              🔥 All-In
            </button>
            <button type="button" class="fvtt-ct-btn danger" data-action="pokerFold">
              🏳️ Fold
            </button>
          {{/if}}
        {{/if}}

        <button type="button" class="fvtt-ct-btn" data-action="sortHand" data-sort-by="suit" title="Ordenar por Naipe">
          <i class="fa-solid fa-arrow-down-a-z"></i> Naipe
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="sortHand" data-sort-by="value" title="Ordenar por Valor">
          <i class="fa-solid fa-arrow-down-1-9"></i> Valor
        </button>
        {{#if isMtg}}
          <button type="button" class="fvtt-ct-btn" data-action="sortHand" data-sort-by="cmc">
            CMC
          </button>
        {{/if}}
      </div>
    </div>

    <div class="fvtt-ct-hand-cards">
      {{#each hand.cards as |card|}}
        <div
          class="fvtt-ct-card {{#if card.selected}}is-selected{{/if}}"
          data-card-id="{{card.id}}"
          data-zone="hand"
        >
          <div class="fvtt-ct-card-image-wrap" data-action="toggleSelectCard">
            <img src="{{card.img}}" alt="{{card.name}}" />
          </div>
          <div class="fvtt-ct-card-title">{{card.name}}</div>
          <div class="fvtt-ct-card-actions">
            <button type="button" data-action="playCardToTable" title="Revelar na Mesa / Showdown (Segure Shift para Baixar Virada)">
              <i class="fa-solid fa-arrow-up"></i> Jogar
            </button>
            <button type="button" data-action="discardCard" title="Desistir / Descartar (Fold)">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      {{else}}
        <p class="fvtt-ct-empty">Sua mão privada está vazia.</p>
      {{/each}}
    </div>
  </footer>
</div>
