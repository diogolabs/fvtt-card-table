<div class="fvtt-card-table-container">
  <!-- BARRA DE MODO DE JOGO (EXCLUSIVA DO GM) E CONTROLES DA PARTIDA -->
  <header class="fvtt-ct-toolbar">
    <div class="fvtt-ct-modes">
      {{#if isGM}}
        <span class="fvtt-ct-gm-label"><i class="fa-solid fa-crown"></i> GM:</span>
        <button type="button" class="fvtt-ct-btn {{#if isStandard}}active{{/if}}" data-action="setGameMode" data-mode="standard" title="Modo Padrão integrado ao sistema nativo de Cartas do Foundry VTT">
          <i class="fa-solid fa-clone"></i> Padrão
        </button>
        <button type="button" class="fvtt-ct-btn {{#if isPoker}}active{{/if}}" data-action="setGameMode" data-mode="poker">
          <i class="fa-solid fa-coins"></i> Poker
        </button>
        <button type="button" class="fvtt-ct-btn {{#if isBuraco}}active{{/if}}" data-action="setGameMode" data-mode="buraco">
          <i class="fa-solid fa-layer-group"></i> Buraco
        </button>
        <button type="button" class="fvtt-ct-btn {{#if isMtg}}active{{/if}}" data-action="setGameMode" data-mode="mtg">
          <i class="fa-solid fa-wand-magic-sparkles"></i> MTG
        </button>
        <button type="button" class="fvtt-ct-btn primary" data-action="bootstrapZones" title="Cria Baralho, Mãos Privadas de cada jogador, Mesa e Descarte automaticamente">
          <i class="fa-solid fa-magic"></i> Preparar Mesa
        </button>
      {{else}}
        <span class="fvtt-ct-badge-gold"><i class="fa-solid fa-diamond"></i> {{gameModeLabel}}</span>
      {{/if}}
    </div>

    <!-- AÇÕES ESPECÍFICAS DO MODO ATIVO (CONTROLES DO CRUPIÊ / GM) -->
    <div class="fvtt-ct-mode-actions">
      {{#if isStandard}}
        {{#if isGM}}
          <button type="button" class="fvtt-ct-btn primary" data-action="standardDealHands" data-count="1" title="Distribui 1 carta do baralho para a mão de cada jogador (Segure Shift para dar fechada)">
            <i class="fa-solid fa-share-nodes"></i> Dar 1 Carta p/ Todos
          </button>
          <button type="button" class="fvtt-ct-btn" data-action="standardDealHands" data-count="5" title="Distribui 5 cartas do baralho para a mão de cada jogador">
            Dar 5 p/ Todos
          </button>
          <button type="button" class="fvtt-ct-btn" data-action="createDiscardPile" title="Cria uma nova Pilha de Descarte no Foundry">
            <i class="fa-solid fa-plus"></i> Nova Pilha de Descarte
          </button>
        {{/if}}
        <button type="button" class="fvtt-ct-btn" data-action="drawCard" data-count="1" title="Compra 1 carta aberta do topo do baralho">
          <i class="fa-solid fa-hand-holding"></i> Comprar 1
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="drawCard" data-count="1" data-facedown="true" title="Compra 1 carta virada para baixo">
          <i class="fa-solid fa-eye-slash"></i> Comprar Fechada
        </button>
      {{/if}}

      {{#if isPoker}}
        {{#if isGM}}
          <button type="button" class="fvtt-ct-btn primary" data-action="pokerStartRound" title="Crupiê: Recolhe tudo, embaralha e dá 2 cartas privadas para cada jogador">
            <i class="fa-solid fa-hat-wizard"></i> Nova Mão (2 Cartas)
          </button>
          <button type="button" class="fvtt-ct-btn primary" data-action="pokerStage" data-stage="auto" title="Crupiê queima 1 carta e abre a próxima etapa (Flop -> Turn -> River)">
            <i class="fa-solid fa-forward-step"></i> Crupiê: Próxima Etapa
          </button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerStage" data-stage="flop">Flop</button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerStage" data-stage="turn">Turn</button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerStage" data-stage="river">River</button>
          <button type="button" class="fvtt-ct-btn danger" data-action="pokerResetPot" title="Zera o Pote e as apostas da rodada">
            <i class="fa-solid fa-broom"></i> Zerar Pote
          </button>
          <button type="button" class="fvtt-ct-btn" data-action="pokerBuyInAll" data-amount="1000" title="Define 1.000 fichas para todos os jogadores">
            <i class="fa-solid fa-coins"></i> Buy-in (1.000)
          </button>
          <button
            type="button"
            class="fvtt-ct-btn {{#if allowSoloPoker}}active{{else}}danger{{/if}}"
            data-action="toggleAllowSoloPoker"
            title="Libera ou bloqueia o modo Solo vs. Crupiê para os jogadores (Pote 100% isolado da mesa multiplayer)"
          >
            {{#if allowSoloPoker}}
              <i class="fa-solid fa-lock-open"></i> Solo vs. Crupiê: Liberado
            {{else}}
              <i class="fa-solid fa-lock"></i> Solo vs. Crupiê: Bloqueado
            {{/if}}
          </button>
        {{/if}}
      {{/if}}

      {{#if isMtg}}
        <button type="button" class="fvtt-ct-btn" data-action="untapAll" title="Ctrl+U: Desvirar todas as permanentes">
          <i class="fa-solid fa-rotate-left"></i> Untap All
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="scryDeck" data-count="2">
          <i class="fa-solid fa-eye"></i> Scry 2
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="mulliganHand">
          <i class="fa-solid fa-shuffle"></i> Mulligan
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="createToken">
          <i class="fa-solid fa-plus-circle"></i> Criar Token
        </button>
      {{/if}}

      {{#if isBuraco}}
        {{#if isGM}}
          <button type="button" class="fvtt-ct-btn primary" data-action="buracoSetup">
            <i class="fa-solid fa-play"></i> Distribuir Mesa (11 + Mortos)
          </button>
        {{/if}}
        <button type="button" class="fvtt-ct-btn" data-action="buracoBuyTrash">
          <i class="fa-solid fa-hand-holding"></i> Comprar Lixo
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="buracoPlayMeld">
          <i class="fa-solid fa-check-double"></i> Baixar Jogo Selecionado
        </button>
      {{/if}}
    </div>
  </header>

  <!-- ÁREA CENTRAL: ZONAS LATERAIS COMPACTAS (DECK + DESCARTE) E CAMPO DE BATALHA / MESA -->
  <div class="fvtt-ct-main-grid">
    <!-- COLUNA ESQUERDA COMPACTA: BARALHO, PILHAS DE DESCARTE E MÃOS -->
    <aside class="fvtt-ct-sidebar-zones">
      <div class="fvtt-ct-zone-box">
        <div class="fvtt-ct-zone-title-row">
          <h4><i class="fa-solid fa-layer-group"></i> {{#if deck}}{{deck.name}}{{else}}Sem Baralho{{/if}}</h4>
          {{#if deck}}
            <button type="button" class="fvtt-ct-icon-btn" data-action="openStackSheet" data-stack-id="{{deck.id}}" title="Abrir janela nativa do Foundry para este Baralho">
              <i class="fa-solid fa-up-right-from-square"></i>
            </button>
          {{/if}}
        </div>

        {{#if isStandard}}
          {{#if hasMultipleDecks}}
            <div class="fvtt-ct-stack-switcher">
              {{#each availableDecks as |d|}}
                <button
                  type="button"
                  class="fvtt-ct-btn mini {{#if d.isSelected}}active{{/if}}"
                  data-action="selectActiveDeck"
                  data-deck-id="{{d.id}}"
                  title="Alternar para o baralho {{d.name}}"
                >
                  {{d.name}} ({{d.availableCount}})
                </button>
              {{/each}}
            </div>
          {{/if}}
        {{/if}}

        {{#if deck}}
          <div class="fvtt-ct-deck-counter">{{deck.availableCount}} / {{deck.totalCount}} cartas disponíveis</div>
          <div class="fvtt-ct-zone-buttons">
            <button type="button" class="fvtt-ct-btn" data-action="drawCard" data-count="1">Comprar 1</button>
            <button type="button" class="fvtt-ct-btn" data-action="shuffleDeck">Embaralhar</button>
            {{#if isGM}}
              <button type="button" class="fvtt-ct-btn" data-action="recallDeck">Resetar</button>
            {{/if}}
          </div>
        {{else}}
          <p class="fvtt-ct-empty">Peça ao GM para clicar em <strong>"Preparar Mesa"</strong> ou criar um Deck no Foundry.</p>
        {{/if}}
      </div>

      {{#if isStandard}}
        <!-- PILHAS DE DESCARTE DO MODO PADRÃO (EXIBE TODAS AS QUE EXISTIREM NO MUNDO) -->
        {{#each discardPiles as |dp|}}
          <div class="fvtt-ct-zone-box fvtt-ct-discard-box {{#if dp.isTarget}}is-active-discard{{/if}}">
            <div class="fvtt-ct-zone-title-row">
              <h4>
                <i class="fa-solid fa-recycle"></i> {{dp.name}} ({{dp.count}})
              </h4>
              <div class="fvtt-ct-zone-mini-actions">
                {{#if ../hasMultipleDiscardPiles}}
                  <button
                    type="button"
                    class="fvtt-ct-btn mini {{#if dp.isTarget}}active{{/if}}"
                    data-action="selectDiscardTarget"
                    data-pile-id="{{dp.id}}"
                    title="Definir como pilha de descarte padrão"
                  >
                    {{#if dp.isTarget}}Alvo{{else}}Usar{{/if}}
                  </button>
                {{/if}}
                <button type="button" class="fvtt-ct-icon-btn" data-action="openStackSheet" data-stack-id="{{dp.id}}" title="Abrir ficha nativa do Foundry">
                  <i class="fa-solid fa-up-right-from-square"></i>
                </button>
              </div>
            </div>

            {{#if dp.topCard}}
              <div class="fvtt-ct-card-mini">
                <img src="{{dp.topCard.img}}" alt="{{dp.topCard.name}}" />
                <div class="fvtt-ct-card-mini-info">
                  <span class="fvtt-ct-card-mini-label">
                    {{#if dp.topCard.isFaceDown}}Carta Virada{{else}}{{dp.topCard.name}}{{/if}}
                  </span>
                  <div class="fvtt-ct-zone-buttons">
                    <button type="button" class="fvtt-ct-btn mini" data-action="drawTopDiscard" data-pile-id="{{dp.id}}" title="Pegar a carta do topo deste descarte para a sua mão">
                      📥 Pegar Topo
                    </button>
                    <button type="button" class="fvtt-ct-btn mini" data-action="returnDiscardToDeck" data-pile-id="{{dp.id}}" title="Devolver todas as cartas deste descarte para o Baralho e embaralhar">
                      🔄 p/ Deck
                    </button>
                  </div>
                </div>
              </div>
            {{else}}
              <p class="fvtt-ct-empty">Pilha de descarte vazia</p>
            {{/if}}
          </div>
        {{else}}
          <div class="fvtt-ct-zone-box">
            <h4><i class="fa-solid fa-recycle"></i> Pilhas de Descarte</h4>
            <p class="fvtt-ct-empty">Nenhuma pilha de descarte separada no mundo.</p>
            {{#if isGM}}
              <button type="button" class="fvtt-ct-btn mini" data-action="createDiscardPile">
                <i class="fa-solid fa-plus"></i> Criar Pilha de Descarte
              </button>
            {{/if}}
          </div>
        {{/each}}

        <!-- LISTA DE MÃOS DOS JOGADORES NO MUNDO (MODO PADRÃO) -->
        <div class="fvtt-ct-zone-box">
          <h4><i class="fa-solid fa-hand"></i> Mãos dos Jogadores</h4>
          <div class="fvtt-ct-player-list">
            {{#each playerHandsList as |ph|}}
              <div class="fvtt-ct-player-row">
                <div class="fvtt-ct-player-info">
                  <strong>{{ph.shortName}}</strong>
                  <span class="fvtt-ct-player-bet">{{ph.count}} carta(s) na mão</span>
                </div>
                <div class="fvtt-ct-zone-mini-actions">
                  {{#unless ph.isMine}}
                    <button
                      type="button"
                      class="fvtt-ct-btn mini"
                      data-action="passSelectedToHand"
                      data-target-hand-id="{{ph.id}}"
                      title="Passar carta(s) selecionada(s) da sua mão para {{ph.shortName}}"
                    >
                      👉 Passar
                    </button>
                  {{/unless}}
                  {{#if ../isGM}}
                    <button type="button" class="fvtt-ct-icon-btn" data-action="openStackSheet" data-stack-id="{{ph.id}}" title="Abrir ficha nativa da mão">
                      <i class="fa-solid fa-up-right-from-square"></i>
                    </button>
                  {{/if}}
                </div>
              </div>
            {{else}}
              <p class="fvtt-ct-empty">Nenhuma mão criada ainda.</p>
            {{/each}}
          </div>
        </div>
      {{else}}
        <div class="fvtt-ct-zone-box fvtt-ct-discard-box">
          <h4>
            <i class="fa-solid fa-fire"></i>
            {{#if isBuraco}}Lixo ({{discard.count}}){{else if isPoker}}Queima / Muck ({{discard.count}}){{else}}Cemitério ({{discard.count}}){{/if}}
          </h4>
          {{#if discard.topCard}}
            <div class="fvtt-ct-card-mini">
              <img src="{{discard.topCard.img}}" alt="{{discard.topCard.name}}" />
              <span class="fvtt-ct-card-mini-label">
                {{#if discard.topCard.isFaceDown}}Carta Oculta / Queimada{{else}}{{discard.topCard.name}}{{/if}}
              </span>
            </div>
          {{else}}
            <p class="fvtt-ct-empty">Vazio</p>
          {{/if}}
        </div>
      {{/if}}

      {{#if isPoker}}
        <!-- PLACAR DE FICHAS DOS JOGADORES E ENTREGA DO POTE -->
        <div class="fvtt-ct-zone-box fvtt-ct-players-bank">
          <h4><i class="fa-solid fa-users"></i> Banca dos Jogadores</h4>
          <div class="fvtt-ct-player-list">
            {{#each playerChipStacks as |p|}}
              <div class="fvtt-ct-player-row {{#if p.folded}}is-folded{{/if}}">
                <div class="fvtt-ct-player-info">
                  <strong>{{p.name}}</strong>
                  <span class="fvtt-ct-player-chips">🪙 {{p.chips}}</span>
                  {{#if p.roundBet}}
                    <span class="fvtt-ct-player-bet">(Na mesa: {{p.roundBet}})</span>
                  {{/if}}
                  {{#if p.folded}}
                    <span class="fvtt-ct-folded-tag">FOLD</span>
                  {{/if}}
                </div>
                {{#if ../isGM}}
                  <button
                    type="button"
                    class="fvtt-ct-btn award-btn"
                    data-action="pokerAwardPot"
                    data-hand-id="{{p.handId}}"
                    title="Entregar todo o Pote da mesa para {{p.name}}"
                  >
                    🏆 Dar Pote
                  </button>
                {{/if}}
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </aside>

    <!-- ÁREA CENTRAL: TABLEZONE / CRUPIÊ TEXAS HOLD'EM / BATTLEFIELD -->
    <main class="fvtt-ct-battlefield">
      <div class="fvtt-ct-zone-header">
        <h3>
          {{#if isPoker}}
            {{#if isSoloPokerView}}
              🤖 Modo Solo vs. Crupiê — Pote Solo Isolado: <span class="fvtt-ct-badge-gold">💰 {{solo.pot}} fichas</span>
              <span class="fvtt-ct-current-bet-badge">Etapa: {{solo.stageLabel}}</span>
            {{else}}
              🎩 Mesa Texas Hold'em — Pote Total: <span class="fvtt-ct-badge-gold">💰 {{battlefield.pot}} fichas</span>
              {{#if battlefield.currentBet}}
                <span class="fvtt-ct-current-bet-badge">Aposta Atual: {{battlefield.currentBet}} fichas</span>
              {{/if}}
            {{/if}}
          {{else if isBuraco}}
            Jogos Baixados / Canastras — Pontos: <span class="fvtt-ct-badge-gold">{{battlefield.buracoScore.total}} pts</span>
          {{else if isStandard}}
            🃏 Pilha da Mesa: {{#if battlefield}}{{battlefield.name}} <span class="fvtt-ct-badge-gold">{{battlefield.cards.length}} carta(s)</span>{{else}}Nenhuma Pilha de Mesa{{/if}}
          {{else}}
            Campo de Batalha (TableZone)
          {{/if}}
        </h3>

        {{#if isStandard}}
          <div class="fvtt-ct-submode-tabs">
            {{#if hasMultiplePiles}}
              {{#each availableTablePiles as |tp|}}
                <button
                  type="button"
                  class="fvtt-ct-btn mini {{#if tp.isSelected}}active{{/if}}"
                  data-action="selectTablePile"
                  data-pile-id="{{tp.id}}"
                  title="Exibir a pilha {{tp.name}} como Pilha da Mesa"
                >
                  {{tp.name}} ({{tp.count}})
                </button>
              {{/each}}
            {{/if}}
            {{#if battlefield}}
              <button type="button" class="fvtt-ct-btn mini" data-action="openStackSheet" data-stack-id="{{battlefield.id}}" title="Abrir janela nativa do Foundry para a Pilha da Mesa">
                <i class="fa-solid fa-up-right-from-square"></i> Ficha da Mesa
              </button>
            {{/if}}
          </div>
        {{/if}}

        {{#if isPoker}}
          {{#if canSeeSoloPoker}}
            <div class="fvtt-ct-submode-tabs">
              <button
                type="button"
                class="fvtt-ct-btn {{#unless isSoloPokerView}}active{{/unless}}"
                data-action="switchPokerSubMode"
                data-submode="multi"
              >
                <i class="fa-solid fa-users"></i> Mesa Multiplayer (Pote: {{battlefield.pot}})
              </button>
              <button
                type="button"
                class="fvtt-ct-btn {{#if isSoloPokerView}}active{{/if}}"
                data-action="switchPokerSubMode"
                data-submode="solo"
              >
                <i class="fa-solid fa-robot"></i> Solo vs. Crupiê (Pote Solo: {{solo.pot}})
              </button>
            </div>
          {{/if}}
        {{/if}}
      </div>

      {{#if isPoker}}
        {{#if isSoloPokerView}}
          <!-- ================================================================= -->
          <!-- MESA SOLO VS. CRUPIÊ (POTE ISOLADO — NÃO AFETA A MESA PRINCIPAL)  -->
          <!-- ================================================================= -->
          <div class="fvtt-ct-solo-arena">
            <div class="fvtt-ct-solo-controls-bar">
              <div class="fvtt-ct-solo-start-group">
                <button type="button" class="fvtt-ct-btn primary" data-action="soloStartHand" data-ante="10">
                  <i class="fa-solid fa-play"></i> Nova Mão Solo (Ante 10)
                </button>
                <button type="button" class="fvtt-ct-btn" data-action="soloStartHand" data-ante="25">
                  Ante 25
                </button>
                <button type="button" class="fvtt-ct-btn" data-action="soloStartHand" data-ante="50">
                  Ante 50
                </button>
              </div>

              {{#if solo.isInProgress}}
                <div class="fvtt-ct-solo-step-group">
                  <button type="button" class="fvtt-ct-btn primary" data-action="soloStep" data-bet="0">
                    ✊ Check / {{solo.nextStageLabel}}
                  </button>
                  <button type="button" class="fvtt-ct-chip-btn chip-10" data-action="soloStep" data-bet="10" title="Apostar +10 (Crupiê cobre +10) e {{solo.nextStageLabel}}">
                    +10
                  </button>
                  <button type="button" class="fvtt-ct-chip-btn chip-25" data-action="soloStep" data-bet="25" title="Apostar +25 (Crupiê cobre +25) e {{solo.nextStageLabel}}">
                    +25
                  </button>
                  <button type="button" class="fvtt-ct-chip-btn chip-50" data-action="soloStep" data-bet="50" title="Apostar +50 (Crupiê cobre +50) e {{solo.nextStageLabel}}">
                    +50
                  </button>
                  <button type="button" class="fvtt-ct-btn allin-btn" data-action="soloStep" data-allin="true" title="Apostar todas as fichas e abrir todas as cartas até o Showdown">
                    🔥 All-In Showdown
                  </button>
                  <button type="button" class="fvtt-ct-btn danger" data-action="soloFold">
                    🏳️ Desistir
                  </button>
                </div>
              {{/if}}
            </div>

            {{#if solo.lastResult}}
              <div class="fvtt-ct-solo-result-banner {{#if solo.lastResult.isWin}}win{{else if solo.lastResult.isTie}}tie{{else}}lose{{/if}}">
                <div class="fvtt-ct-solo-result-title">{{solo.lastResult.title}}</div>
                <div class="fvtt-ct-solo-result-desc">{{solo.lastResult.summary}}</div>
                <div class="fvtt-ct-solo-result-hands">
                  <span><strong>Seu Jogo:</strong> {{solo.lastResult.playerHandName}}</span>
                  <span>•</span>
                  <span><strong>Jogo do Crupiê:</strong> {{solo.lastResult.dealerHandName}}</span>
                </div>
              </div>
            {{/if}}

            <!-- MÃO DO CRUPIÊ E MÃO DO JOGADOR LADO A LADO -->
            <div class="fvtt-ct-solo-duel-row">
              <div class="fvtt-ct-solo-side-box">
                <h4>🎩 Mão do Crupiê (Banca)</h4>
                <div class="fvtt-ct-card-grid">
                  {{#each solo.dealerCards as |card|}}
                    <div class="fvtt-ct-card">
                      {{#if ../solo.isShowdown}}
                        <div class="fvtt-ct-solo-card-face {{#if card.isRed}}is-red{{/if}}">
                          <span class="fvtt-ct-solo-corner">{{card.shortLabel}}</span>
                          <span class="fvtt-ct-solo-big-suit">{{card.symbol}}</span>
                        </div>
                        <div class="fvtt-ct-card-title">{{card.name}}</div>
                      {{else}}
                        <div class="fvtt-ct-solo-card-back">
                          <i class="fa-solid fa-hat-wizard"></i>
                          <span>Carta da Banca</span>
                        </div>
                        <div class="fvtt-ct-card-title">Oculta até o Showdown</div>
                      {{/if}}
                    </div>
                  {{else}}
                    <p class="fvtt-ct-empty">Clique em "Nova Mão Solo" acima para o Crupiê distribuir.</p>
                  {{/each}}
                </div>
              </div>

              <div class="fvtt-ct-solo-side-box">
                <h4>
                  🧑 Suas Cartas no Solo
                  {{#if solo.playerLiveEval}}
                    <span class="fvtt-ct-badge-gold">{{solo.playerLiveEval}}</span>
                  {{/if}}
                </h4>
                <div class="fvtt-ct-card-grid">
                  {{#each solo.playerCards as |card|}}
                    <div class="fvtt-ct-card">
                      <div class="fvtt-ct-solo-card-face {{#if card.isRed}}is-red{{/if}}">
                        <span class="fvtt-ct-solo-corner">{{card.shortLabel}}</span>
                        <span class="fvtt-ct-solo-big-suit">{{card.symbol}}</span>
                      </div>
                      <div class="fvtt-ct-card-title">{{card.name}}</div>
                    </div>
                  {{else}}
                    <p class="fvtt-ct-empty">Nenhuma mão solo ativa.</p>
                  {{/each}}
                </div>
              </div>
            </div>

            <!-- 5 SLOTS COMUNITÁRIOS DO CRUPIÊ SOLO (FLOP 1-3, TURN, RIVER) -->
            <div class="fvtt-ct-dealer-board">
              {{#each solo.dealerSlots as |slot|}}
                <div class="fvtt-ct-dealer-slot {{#if slot.card}}filled{{/if}}">
                  <div class="fvtt-ct-slot-label">{{slot.label}}</div>
                  {{#if slot.card}}
                    <div class="fvtt-ct-card">
                      <div class="fvtt-ct-solo-card-face {{#if slot.card.isRed}}is-red{{/if}}">
                        <span class="fvtt-ct-solo-corner">{{slot.card.shortLabel}}</span>
                        <span class="fvtt-ct-solo-big-suit">{{slot.card.symbol}}</span>
                      </div>
                      <div class="fvtt-ct-card-title">{{slot.card.name}}</div>
                    </div>
                  {{else}}
                    <div class="fvtt-ct-slot-placeholder">
                      <span>Aguardando {{slot.label}}</span>
                    </div>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          </div>
        {{else}}
          <!-- 5 SLOTS OFICIAIS DO CRUPIÊ MULTIPLAYER (FLOP 1, FLOP 2, FLOP 3, TURN, RIVER) -->
          <div class="fvtt-ct-dealer-board">
            {{#each dealerSlots as |slot|}}
              <div class="fvtt-ct-dealer-slot {{#if slot.card}}filled{{/if}}">
                <div class="fvtt-ct-slot-label">{{slot.label}}</div>
                {{#if slot.card}}
                  <div class="fvtt-ct-card" data-card-id="{{slot.card.id}}" data-zone="battlefield">
                    <div class="fvtt-ct-card-image-wrap">
                      <img src="{{slot.card.img}}" alt="{{slot.card.name}}" />
                    </div>
                    <div class="fvtt-ct-card-title">{{slot.card.name}}</div>
                  </div>
                {{else}}
                  <div class="fvtt-ct-slot-placeholder">
                    <span>Aguardando Crupiê</span>
                  </div>
                {{/if}}
              </div>
            {{/each}}
          </div>

          <!-- ÁREA DE SHOWDOWN (CARTAS BAIXADAS DA MÃO PELOS JOGADORES) -->
          <div class="fvtt-ct-showdown-section">
            <h4><i class="fa-solid fa-eye"></i> Showdown — Cartas Reveladas pelos Jogadores</h4>
            <div class="fvtt-ct-card-grid">
              {{#each showdownCards as |card|}}
                <div class="fvtt-ct-card" data-card-id="{{card.id}}" data-zone="battlefield">
                  <div class="fvtt-ct-card-image-wrap">
                    <img src="{{card.img}}" alt="{{card.name}}" />
                    {{#if card.playedBy}}
                      <span class="fvtt-ct-meld-tag">{{card.playedBy}}</span>
                    {{/if}}
                  </div>
                  <div class="fvtt-ct-card-title">{{#if card.isFaceDown}}Carta Oculta{{else}}{{card.name}}{{/if}}</div>
                  <div class="fvtt-ct-card-actions">
                    <button type="button" data-action="flipCard" title="Virar Face/Verso">
                      <i class="fa-solid fa-repeat"></i>
                    </button>
                    <button type="button" data-action="discardCard" title="Enviar para Muck / Descarte">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                </div>
              {{else}}
                <p class="fvtt-ct-empty">Nenhuma carta de jogador revelada ainda (clique em "Jogar" na sua mão na hora do Showdown).</p>
              {{/each}}
            </div>
          </div>
        {{/if}}
      {{else}}
        <!-- MODO MTG / BURACO -->
        <div class="fvtt-ct-card-grid">
          {{#each battlefield.cards as |card|}}
            <div
              class="fvtt-ct-card {{#if card.tapped}}is-tapped{{/if}} {{#if card.selected}}is-selected{{/if}}"
              data-card-id="{{card.id}}"
              data-zone="battlefield"
            >
              <div class="fvtt-ct-card-image-wrap" data-action="toggleTapCard" title="Clique para Virar 90° (Tap/Untap)">
                <img src="{{card.img}}" alt="{{card.name}}" />
                {{#if card.playedBy}}
                  <span class="fvtt-ct-meld-tag">{{card.playedBy}}</span>
                {{/if}}
                {{#if card.meldGroupId}}
                  <span class="fvtt-ct-meld-tag">Jogo #{{card.meldGroupId}}</span>
                {{/if}}
                {{#if card.counters.plusOne}}
                  <span class="fvtt-ct-counter-badge plus-one">+{{card.counters.plusOne}}/+{{card.counters.plusOne}}</span>
                {{/if}}
              </div>
              <div class="fvtt-ct-card-title">{{#if card.isFaceDown}}Carta Virada{{else}}{{card.name}}{{/if}}</div>
              <div class="fvtt-ct-card-actions">
                {{#if ../isStandard}}
                  <button type="button" data-action="takeCardToHand" title="Pegar carta da mesa para a sua mão">
                    <i class="fa-solid fa-hand-holding"></i>
                  </button>
                {{/if}}
                <button type="button" data-action="toggleTapCard" title="Girar 90° (Tap / Untap)">
                  <i class="fa-solid fa-rotate-right"></i>
                </button>
                <button type="button" data-action="flipCard" title="Virar Face/Verso">
                  <i class="fa-solid fa-repeat"></i>
                </button>
                {{#if ../isMtg}}
                  <button type="button" data-action="modifyCounter" data-counter="plusOne" data-delta="1" title="+1/+1">
                    +1
                  </button>
                  <button type="button" data-action="modifyCounter" data-counter="plusOne" data-delta="-1" title="-1/-1">
                    -1
                  </button>
                {{/if}}
                <button type="button" data-action="discardCard" title="Enviar para Pilha de Descarte / Cemitério / Lixo">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          {{else}}
            <p class="fvtt-ct-empty">Nenhuma carta na mesa no momento.</p>
          {{/each}}
        </div>
      {{/if}}
    </main>
  </div>

  <!-- DOCK INFERIOR: MÃO PRIVADA DO JOGADOR LOGADO + CONTROLES DE APOSTA DE FICHAS -->
  <footer class="fvtt-ct-hand-dock">
    <div class="fvtt-ct-hand-header">
      <div class="fvtt-ct-hand-title-group">
        <h4>
          <i class="fa-solid fa-lock"></i>
          {{#if hand}}
            {{hand.name}} ({{hand.cards.length}} cartas)
          {{else}}
            Sem Mão Privada
            <button type="button" class="fvtt-ct-btn primary" data-action="ensureMyHand">Criar Minha Mão Privada</button>
          {{/if}}
        </h4>

        {{#if isPoker}}
          {{#if hand}}
            <div class="fvtt-ct-chip-wallet">
              <span class="fvtt-ct-wallet-balance">🪙 Minhas Fichas: <strong>{{hand.chips}}</strong></span>
              <span class="fvtt-ct-wallet-round">Na rodada: <strong>{{hand.roundBet}}</strong></span>
            </div>
          {{/if}}
        {{/if}}
      </div>

      <div class="fvtt-ct-hand-controls">
        {{#if isPoker}}
          {{#unless isSoloPokerView}}
            {{#if hand}}
              <!-- BARRA DE APOSTAS DO JOGADOR NA MESA MULTIPLAYER (CHECK/CALL, FICHAS, CUSTOM, ALL-IN, FOLD) -->
              <button type="button" class="fvtt-ct-btn primary" data-action="pokerCheckOrCall">
                {{#if hand.canCheck}}
                  ✊ Check (Mesa)
                {{else}}
                  📞 Call (Pagar {{hand.toCall}})
                {{/if}}
              </button>
              <button type="button" class="fvtt-ct-chip-btn chip-10" data-action="pokerBet" data-amount="10">+10</button>
              <button type="button" class="fvtt-ct-chip-btn chip-25" data-action="pokerBet" data-amount="25">+25</button>
              <button type="button" class="fvtt-ct-chip-btn chip-50" data-action="pokerBet" data-amount="50">+50</button>
              <button type="button" class="fvtt-ct-chip-btn chip-100" data-action="pokerBet" data-amount="100">+100</button>
              <div class="fvtt-ct-custom-bet-wrap">
                <input type="number" class="fvtt-ct-custom-bet-input" placeholder="Valor" min="1" step="5" value="20" />
                <button type="button" class="fvtt-ct-btn" data-action="pokerCustomBet">Apostar</button>
              </div>
              <button type="button" class="fvtt-ct-btn allin-btn" data-action="pokerAllIn">
                🔥 All-In
              </button>
              <button type="button" class="fvtt-ct-btn danger" data-action="pokerFold">
                🏳️ Fold
              </button>
            {{/if}}
          {{/unless}}
        {{/if}}

        <button type="button" class="fvtt-ct-btn" data-action="sortHand" data-sort-by="suit" title="Ordenar por Naipe">
          <i class="fa-solid fa-arrow-down-a-z"></i> Naipe
        </button>
        <button type="button" class="fvtt-ct-btn" data-action="sortHand" data-sort-by="value" title="Ordenar por Valor">
          <i class="fa-solid fa-arrow-down-1-9"></i> Valor
        </button>
        {{#if isMtg}}
          <button type="button" class="fvtt-ct-btn" data-action="sortHand" data-sort-by="cmc">
            CMC
          </button>
        {{/if}}
      </div>
    </div>

    <div class="fvtt-ct-hand-cards">
      {{#each hand.cards as |card|}}
        <div
          class="fvtt-ct-card {{#if card.selected}}is-selected{{/if}}"
          data-card-id="{{card.id}}"
          data-zone="hand"
        >
          <div class="fvtt-ct-card-image-wrap" data-action="toggleSelectCard">
            <img src="{{card.img}}" alt="{{card.name}}" />
          </div>
          <div class="fvtt-ct-card-title">{{#if card.isFaceDown}}Carta Virada{{else}}{{card.name}}{{/if}}</div>
          <div class="fvtt-ct-card-actions">
            <button type="button" data-action="playCardToTable" title="Jogar na Pilha da Mesa (Segure Shift para Baixar Virada)">
              <i class="fa-solid fa-arrow-up"></i> Jogar
            </button>
            <button type="button" data-action="flipCard" title="Virar Face/Verso na Mão">
              <i class="fa-solid fa-repeat"></i>
            </button>
            <button type="button" data-action="discardCard" title="Enviar para Pilha de Descarte">
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
        </div>
      {{else}}
        <p class="fvtt-ct-empty">Sua mão privada está vazia.</p>
      {{/each}}
    </div>
  </footer>
</div>
